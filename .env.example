# Endereço do servidor Ollama.
# Ambiente institucional (acessível na rede interna llm-network): https://llm-internal.softex:9001
# Ambiente local: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Nome/tag exata do modelo disponível no servidor Ollama em uso (ex.: qwen3.5).
OLLAMA_MODEL=qwen3.5

# Verificação de certificado SSL nas requisições HTTPS.
# O servidor institucional usa certificado autogerado; use false nesse cenário
# e true em ambientes com certificado SSL válido.
LLM_VERIFY_SSL=false
